<?xml version="1.0" encoding="UTF-8"?>
<openbox_menu xmlns="http://openbox.org/3.4/menu">
  <menu id="root-menu" label="FeatherOS">
    <item label="Start Menu">
      <action name="Execute"><command>jgmenu_run</command></action>
    </item>
    <separator/>
    <item label="Compatibility Manager (Windows Apps)">
      <action name="Execute"><command>feather-compat</command></action>
    </item>
    <item label="File Explorer">
      <action name="Execute"><command>pcmanfm</command></action>
    </item>
    <item label="Windows C: Drive">
      <action name="Execute"><command>pcmanfm ~/.local/share/featheros/bottles/default/prefix/drive_c</command></action>
    </item>
    <item label="Terminal">
      <action name="Execute"><command>lxterminal</command></action>
    </item>
    <separator/>
    <menu id="profiles-menu" label="Performance Profile">
      <item label="Balanced (Default)">
        <action name="Execute"><command>feather-ctl profile balanced</command></action>
      </item>
      <item label="Low-RAM Saver (2-4 GB PCs)">
        <action name="Execute"><command>feather-ctl profile low-ram</command></action>
      </item>
      <item label="Gaming Performance">
        <action name="Execute"><command>feather-ctl profile gaming</command></action>
      </item>
    </menu>
    <separator/>
    <item label="Log Out">
      <action name="Exit"><prompt>yes</prompt></action>
    </item>
    <item label="Reboot">
      <action name="Execute"><command>systemctl reboot</command></action>
    </item>
    <item label="Shut Down">
      <action name="Execute"><command>systemctl poweroff</command></action>
    </item>
  </menu>
</openbox_menu>
