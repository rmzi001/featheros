# FeatherOS Windows-Style Lightweight Taskbar (Tint2)
#-------------------------------------
# Backgrounds
# Background 1: Panel bar
rounded = 0
border_width = 1
border_sides = T
background_color = #0f172a 94
border_color = #1e293b 100

# Background 2: Active taskbar window
rounded = 4
border_width = 2
border_sides = B
background_color = #1e293b 95
border_color = #38bdf8 100

# Background 3: Default taskbar window
rounded = 4
border_width = 0
background_color = #0f172a 0
border_color = #0f172a 0

# Background 4: Urgent / hover button
rounded = 4
border_width = 0
background_color = #334155 90
border_color = #38bdf8 100

# Background 5: Start button
rounded = 6
border_width = 1
background_color = #0284c7 95
border_color = #38bdf8 100

#-------------------------------------
# Panel
panel_items = P L T S C
panel_size = 100% 40
panel_margin = 0 0
panel_padding = 8 4 8
panel_background_id = 1
wm_menu = 1
panel_dock = 0
panel_position = bottom center horizontal
panel_layer = top
panel_monitor = all
strut_policy = follow_size
autohide = 0

#-------------------------------------
# Start Button (P)
button = new
button_text = ❖ Start
button_tooltip = FeatherOS Start Menu (Super)
button_font = Sans Bold 10
button_font_color = #f8fafc 100
button_background_id = 5
button_padding = 12 4
button_lclick_command = jgmenu_run
button_rclick_command = feather-compat

#-------------------------------------
# Pinned Launcher (L)
launcher_padding = 6 2 6
launcher_background_id = 0
launcher_icon_size = 22
launcher_icon_theme = Papirus-Dark
launcher_item_app = /usr/share/applications/pcmanfm.desktop
launcher_item_app = /usr/share/applications/feather-compat.desktop
launcher_item_app = /usr/share/applications/feather-store.desktop
launcher_item_app = /usr/share/applications/lxterminal.desktop

#-------------------------------------
# Taskbar (T)
taskbar_mode = single_desktop
taskbar_hide_if_empty = 0
taskbar_padding = 4 2 4
taskbar_background_id = 0
task_icon = 1
task_text = 1
task_centered = 0
task_maximum_size = 190 32
task_padding = 8 4 6
task_font = Sans 9
task_font_color = #cbd5e1 100
task_active_font_color = #f8fafc 100
task_background_id = 3
task_active_background_id = 2
task_urgent_background_id = 4
mouse_left = toggle_iconify
mouse_middle = close
mouse_right = shade

#-------------------------------------
# System Tray (S)
systray_padding = 6 4 6
systray_background_id = 0
systray_sort = ascending
systray_icon_size = 20

#-------------------------------------
# Clock (C)
time1_format = %H:%M
time2_format = %b %d
time1_font = Sans Bold 9
time2_font = Sans 8
clock_font_color = #e2e8f0 100
clock_padding = 8 2
clock_background_id = 0
clock_lclick_command = feather-compat
