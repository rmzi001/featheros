# FeatherDark — Clean modern flat Openbox window theme

border.width: 1
padding.width: 8
padding.height: 6
window.handle.width: 0
window.client.padding.width: 0
window.client.padding.height: 0
menu.overlap.x: -2
menu.overlap.y: 0

# Active window
window.active.title.bg: flat solid
window.active.title.bg.color: #0f172a
window.active.label.bg: parentrelative
window.active.label.text.color: #f8fafc
window.active.border.color: #38bdf8
window.active.button.unpressed.bg: parentrelative
window.active.button.unpressed.image.color: #cbd5e1
window.active.button.hover.bg: flat solid
window.active.button.hover.bg.color: #1e293b
window.active.button.hover.image.color: #38bdf8
window.active.button.pressed.bg: flat solid
window.active.button.pressed.bg.color: #38bdf8
window.active.button.pressed.image.color: #0f172a
window.active.button.disabled.bg: parentrelative
window.active.button.disabled.image.color: #475569
window.active.button.close.hover.bg: flat solid
window.active.button.close.hover.bg.color: #ef4444
window.active.button.close.hover.image.color: #ffffff

# Inactive window
window.inactive.title.bg: flat solid
window.inactive.title.bg.color: #1e293b
window.inactive.label.bg: parentrelative
window.inactive.label.text.color: #94a3b8
window.inactive.border.color: #334155
window.inactive.button.unpressed.bg: parentrelative
window.inactive.button.unpressed.image.color: #64748b
window.inactive.button.hover.bg: flat solid
window.inactive.button.hover.bg.color: #334155
window.inactive.button.hover.image.color: #e2e8f0
window.inactive.button.pressed.bg: parentrelative
window.inactive.button.pressed.image.color: #94a3b8
window.inactive.button.disabled.bg: parentrelative
window.inactive.button.disabled.image.color: #334155

# Menus
menu.border.width: 1
menu.border.color: #334155
menu.title.bg: flat solid
menu.title.bg.color: #0f172a
menu.title.text.color: #38bdf8
menu.title.text.justify: left
menu.items.bg: flat solid
menu.items.bg.color: #111827
menu.items.text.color: #e2e8f0
menu.items.disabled.text.color: #64748b
menu.items.active.bg: flat solid
menu.items.active.bg.color: #1e293b
menu.items.active.text.color: #38bdf8
menu.separator.color: #1f2937
menu.separator.width: 1
menu.separator.padding.width: 8
menu.separator.padding.height: 4

# OSD (Alt+Tab switcher)
osd.border.width: 1
osd.border.color: #38bdf8
osd.bg: flat solid
osd.bg.color: #0f172a
osd.label.bg: parentrelative
osd.label.text.color: #f8fafc
osd.hilight.bg: flat solid
osd.hilight.bg.color: #38bdf8
osd.unhilight.bg: flat solid
osd.unhilight.bg.color: #1e293b
