[Desktop Entry]
Type=Application
Version=1.0
Name=FeatherOS System Diagnostics
Comment=Run the automated FeatherOS QA self-test, Wine doctor, and system profile status
Exec=xfce4-terminal -x bash -c 'feather-selftest --quick; echo; feather-run doctor; echo; read -r -p "Press Enter to exit..." _'
Icon=utilities-system-monitor
Terminal=false
Categories=System;Monitor;
